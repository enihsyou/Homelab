(common) {
    # enables error logging
    errors {
        consolidate 5m ".* i/o timeout$" warning
        consolidate 30s "^Failed to .+" error
    }

    # fast failing
    cancel 200ms

    # only allow local network access
    acl {
        allow net 192.168.0.0/16
        block
    }

    # drop AAAA queries, since docker IPv6 range is not routable on local network
    template IN AAAA . {
        rcode NOERROR
    }
}

# resolve docker names through Docker internal DNS
docker.:53 {
    import common

    # forward to docker internal DNS server
    forward . 127.0.0.11 {
        # disables active health checks
        max_fails 0

        max_concurrent 1000
    }
}

# alias docker.kokomi.site to docker
docker.kokomi.site.:53 {
    import common

    rewrite stop {
        name suffix .docker.kokomi.site. .docker. answer auto
    }

    forward . 127.0.0.11 {
        # disables active health checks
        max_fails 0

        max_concurrent 1000
    }
}