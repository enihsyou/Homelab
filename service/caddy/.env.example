# Cloudflare API token used by Caddy's Cloudflare DNS plugin.
# Get one at: https://dash.cloudflare.com/profile/api-tokens
# Use the "Edit zone DNS" template, restricted to the zones Caddy should manage.
# Copy this file to .env and fill in the real values. The .env file is gitignored.

CF_API_TOKEN=

# PushDeer push key for ddns-go webhook notifications.
# Get one from the PushDeer app.
PUSHDEER_KEY=