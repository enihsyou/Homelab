# Reverse-proxy OpenList onto list.home.kokomi.site.
# OpenList only serves HTTPS inside the container; skip cert verification
# because the upstream cert is self-signed. TLS still terminates at Caddy
# for the public side with a real Let's Encrypt cert.
list.home.kokomi.site {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	reverse_proxy https://openlist {
		transport http {
			tls_insecure_skip_verify
		}
	}
}