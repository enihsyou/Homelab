# Minimal Caddyfile — serves the default HTTP site on :80.
# Per-site config lives in Caddyfile.d/*.conf and is imported below.
{
	# https://github.com/caddy-dns/cloudflare
	dns cloudflare {env.CLOUDFLARE_API_TOKEN}

	# https://github.com/mholt/caddy-dynamicdns
	dynamic_dns {
		provider cloudflare {env.CLOUDFLARE_API_TOKEN}
		domains {
			kokomi.site
		}
		dynamic_domains
		versions ipv6
		ip_source interface eth0
		# GUA ranges
		include 2000::/3
	}
	# Caddy runtime log
	log {
		format console {
			time_local
		}
	}
}

import /etc/caddy/Caddyfile.d/*.caddyfile
