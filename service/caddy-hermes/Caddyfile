# Caddyfile on hermes-agent instance.
{
	# https://github.com/caddy-dns/cloudflare
	dns cloudflare {env.CLOUDFLARE_API_TOKEN}

	# https://github.com/mholt/caddy-dynamicdns
	dynamic_dns {
		provider cloudflare {env.CLOUDFLARE_API_TOKEN}
		domains {
			kokomi.site
		}
		dynamic_domains
		versions ipv6
		ip_source interface eth0
		# GUA ranges
		include 2000::/3
	}
	# Caddy runtime log
	log {
		output file /run/caddy/caddy.log {
			roll_at 00:00 localtime
		}
		format console {
			time_local
		}
	}
}

import Caddyfile.d/*.caddyfile
